{
  "$schema": "./node_modules/@wastech-mdlint/cli/schema.json",
  "include": [
    "./*.md",
    "docs/**/*.md",
    ".agents/**/*.md",
    "skills/**/*.md",
    "packages/*/README.md"
  ],
  "rules": [
    { "rule": "REF-001" },
    { "rule": "REF-002" },
    { "rule": "REF-003" },
    { "rule": "GRP-001" },
    { "rule": "TBL-002" },
    {
      "rule": "LLM-001",
      "options": {
        "entrypoints": ["./CLAUDE.md", "./AGENTS.md"],
        "maxTokensPerEntrypoint": 10000
      }
    },
    {
      "rule": "SIZE-001",
      "options": {
        "overrides": [
          {
            "pattern": "skills/**/SKILL.md",
            "lines": { "warn": 500 },
            "tokens": { "warn": 5000 }
          }
        ]
      }
    }
  ]
}
