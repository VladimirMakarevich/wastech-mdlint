{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Restated even though tsconfig.base.json sets it: project references require every
    // referenced project to be composite, so keep it explicit at the package boundary.
    "composite": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  // The browser script is its own project with DOM types and no Node types; compiling it here would
  // let it call Node APIs that do not exist in a page.
  "exclude": ["src/client/**"],
  "references": [{ "path": "../core" }]
}
