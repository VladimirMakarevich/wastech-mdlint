# P16.03 / W-32. `engines.node: ">=24.17.0"` was advisory: `npm ci` printed EBADENGINE for the
# root and all three packages and exited 0, so the floor was declared and never exercised — the
# whole 2026-08-05 field test ran on v24.8.0. This makes it exercised where we control the
# install. CI installs exactly .node-version (24.17.0). It cannot bind a *consumer*: engine-strict
# is the installer's config, not the package's — see docs/mdlint_v2/accepted-behaviors.md.
#
# This file is tracked, so it holds project config only. Credentials — `_authToken`, `_auth`, any
# registry line carrying one — go in `~/.npmrc`, which npm merges over this one. There is no
# project-level override file to ignore instead: npm reads `./.npmrc`, `~/.npmrc` and the global
# config, and nothing else. Publishing (PR.02) authenticates through the CI job's token, not here.
engine-strict=true
