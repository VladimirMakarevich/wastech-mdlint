# `engines.node: ">=24.17.0"` is advisory on its own: `npm ci` prints EBADENGINE for the root and
# all three packages and still exits 0, so without this line the floor is declared and never
# exercised — a full field test once ran the whole product on v24.8.0 with nothing objecting.
# `engine-strict` turns the declaration into a failure where we control the install; CI installs
# exactly the version pinned in .node-version (24.17.0). It cannot bind a *consumer*: engine-strict
# is the installing client's own config, not something a published package can impose, so someone
# on an older Node still gets a warning and a successful install. That gap is accepted, not
# overlooked — there is no package-side mechanism that closes it.
#
# This file is tracked, so it holds project config only. Credentials — `_authToken`, `_auth`, any
# registry line carrying one — go in `~/.npmrc`, which npm merges over this one. There is no
# project-level override file to ignore instead: npm reads `./.npmrc`, `~/.npmrc` and the global
# config, and nothing else. Publishing authenticates through the CI job's token, not here.
engine-strict=true
